{
  "name": "threadnull/idm-core",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Ilya Sirotin",
      "email": "me@threadnull.com"
    }
  ],
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  },
  "autoload": {
    "files": [
      "src/env.php"
    ],
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require": {
    "php": "^8.4",
    "doctrine/dbal": "^4.0",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.0",
    "laminas/laminas-config-aggregator": "^1.18",
    "league/oauth2-server": "^9.2",
    "middlewares/trailing-slash": "^2.1",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "slim/psr7": "^1.7",
    "slim/slim": "4.*",
    "symfony/cache": "^8.0",
    "symfony/console": "^8.0",
    "symfony/var-exporter": "^7.0",
    "twig/twig": "^3.21"
  },
  "scripts": {
    "app": "php bin/app.php --ansi"
  }
}
